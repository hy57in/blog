{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "react",
    "jsx-a11y",
    "nextjs",
    "import",
    "promise",
    "node"
  ],
  "categories": {
    "correctness": "deny",
    "suspicious": "deny",
    "perf": "warn"
  },
  "ignorePatterns": [
    ".next/**",
    "public/**"
  ],
  "settings": {
    "react": {
      "version": "19.2.8"
    }
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off"
  }
}
